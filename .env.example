# Shop Support Agent Environment Configuration

# Integration Mode: simulated | sandbox
INTEGRATION_MODE=simulated

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/shopagent
DATABASE_URL_SYNC=postgresql+psycopg://postgres:postgres@localhost:5432/shopagent
DATABASE_TEST_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/shopagent_test

# LLM Providers & Keys
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# LLM Model Roles Configuration
LLM_PRIMARY_PROVIDER=gemini
LLM_PRIMARY_MODEL=gemini-2.5-flash
LLM_FALLBACK_PROVIDER=fake
LLM_FALLBACK_MODEL=fake-model
LLM_CHEAP_PROVIDER=gemini
LLM_CHEAP_MODEL=gemini-2.5-flash-lite
LLM_SIM_PROVIDER=gemini
LLM_SIM_MODEL=gemini-2.5-flash

# JWT & Authentication Secrets
JWT_SECRET=dev_jwt_secret_change_in_production_32charsmin!
JWT_REFRESH_SECRET=dev_jwt_refresh_secret_change_in_prod_32c!
JWT_ACCESS_EXPIRE_MINUTES=15
JWT_REFRESH_EXPIRE_DAYS=7

# Observability (Phoenix / OpenTelemetry)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:6006/v1/traces
PHOENIX_PROJECT_NAME=shop-support-agent

# VNPay Sandbox (Optional)
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_API_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction

# Server & Worker
HOST=0.0.0.0
PORT=8000
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Optional: true enables cross-encoder reranking of policy lookups (needs `uv sync --extra rerank`, ~570 MB model)
RETRIEVAL_RERANKER_ENABLED=

# Optional: false turns off the dense half of policy retrieval (BM25 only); default is on (needs the `rerank` extra, ~2.3 GB model)
RETRIEVAL_EMBEDDING_ENABLED=
